# SR Vision Lab Environment Variables (Optional)
# If left blank, sensible auto-detected defaults are used

# Force computation device: 'cpu' or 'cuda' (auto-detected by default)
DEVICE=cpu

# Path to custom weights if stored outside models/
# MODEL_WEIGHTS_PATH=models/RRDB_ESRGAN_x4.pth

# Maximum upload file size in Megabytes
MAX_IMAGE_SIZE_MB=15.0

# OpenMP workaround flag for Windows (Defaults to TRUE in config.py)
KMP_DUPLICATE_LIB_OK=TRUE
